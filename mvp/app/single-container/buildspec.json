{
  "version": "1.0",
  "name": "mern-mvp",
  "tag": "mern-mvp:latest",
  "base": {
    "image": "node",
    "tag": "18-alpine"
  },
  "workdir": "/app",
  "env": {
    "NODE_ENV": "production",
    "MONGO_HOST": "localhost",
    "MONGO_PORT": "27017",
    "MONGO_DB": "todos",
    "PORT": "5000"
  },
  "expose": [3000, 5000, 27017],
  "steps": [
    {
      "type": "run",
      "command": "apk add --no-cache mongodb mongodb-tools curl",
      "comment": "Install MongoDB and utilities"
    },
    {
      "type": "run",
      "command": "mkdir -p /app/data /app/logs",
      "comment": "Create data and log directories"
    },
    {
      "type": "copy",
      "source": "app",
      "dest": "/app",
      "comment": "Copy application files"
    },
    {
      "type": "run",
      "command": "cd /app/backend && npm install --production",
      "comment": "Install backend dependencies"
    },
    {
      "type": "run",
      "command": "cd /app/frontend && npm install && npm run build",
      "comment": "Install frontend dependencies and build"
    },
    {
      "type": "run",
      "command": "chmod +x /app/scripts/start.sh",
      "comment": "Make start script executable"
    },
    {
      "type": "volume",
      "dest": "/app/data",
      "comment": "MongoDB data volume"
    },
    {
      "type": "volume",
      "dest": "/app/logs",
      "comment": "Application logs volume"
    },
    {
      "type": "cmd",
      "command": "/app/scripts/start.sh",
      "comment": "Start MongoDB, Backend, and Frontend"
    }
  ],
  "health": {
    "type": "http",
    "path": "/health",
    "port": 5000,
    "interval": 30,
    "timeout": 10,
    "retries": 3
  },
  "labels": {
    "app": "mern-mvp",
    "version": "1.0.0",
    "maintainer": "NebulaBox MVP Testing"
  },
  "metadata": {
    "description": "MERN Stack MVP for NebulaBox testing",
    "stack": ["mongodb", "express", "react", "nodejs"]
  }
}

