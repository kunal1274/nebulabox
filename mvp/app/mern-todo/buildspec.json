{
  "version": "1.0",
  "name": "mern-todo",
  "tag": "mern-todo:latest",
  "base": {
    "image": "node",
    "tag": "18-alpine"
  },
  "workdir": "/app",
  "env": {
    "NODE_ENV": "production",
    "MONGODB_URI": "mongodb://localhost:27017/todos",
    "PORT": "5000",
    "REACT_APP_API_URL": "http://localhost:5000"
  },
  "expose": [3000, 5000, 27017],
  "steps": [
    {
      "type": "run",
      "command": "apk add --no-cache mongodb mongodb-tools curl nginx",
      "comment": "Install MongoDB, nginx, and utilities"
    },
    {
      "type": "run",
      "command": "mkdir -p /app/data /app/logs /app/backend /app/frontend",
      "comment": "Create directories"
    },
    {
      "type": "copy",
      "source": "backend",
      "dest": "/app/backend",
      "comment": "Copy backend files"
    },
    {
      "type": "copy",
      "source": "frontend",
      "dest": "/app/frontend",
      "comment": "Copy frontend files"
    },
    {
      "type": "run",
      "command": "cd /app/backend && npm install --production",
      "comment": "Install backend dependencies"
    },
    {
      "type": "run",
      "command": "cd /app/frontend && npm install && npm run build",
      "comment": "Install frontend dependencies and build React app"
    },
    {
      "type": "run",
      "command": "cp -r /app/frontend/build /usr/share/nginx/html",
      "comment": "Copy built React app to nginx"
    },
    {
      "type": "run",
      "command": "echo 'server { listen 80; root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ /index.html; } location /api { proxy_pass http://localhost:5000; proxy_set_header Host $host; } }' > /etc/nginx/conf.d/default.conf",
      "comment": "Configure nginx to serve React app and proxy API"
    },
    {
      "type": "run",
      "command": "chmod +x /app/scripts/start.sh",
      "comment": "Make start script executable"
    },
    {
      "type": "volume",
      "dest": "/app/data",
      "comment": "MongoDB data volume"
    },
    {
      "type": "volume",
      "dest": "/app/logs",
      "comment": "Application logs volume"
    },
    {
      "type": "cmd",
      "command": "/app/scripts/start.sh",
      "comment": "Start MongoDB, Backend, and Nginx"
    }
  ],
  "health": {
    "type": "http",
    "path": "/api/health",
    "port": 5000,
    "interval": 30,
    "timeout": 10,
    "retries": 3
  },
  "labels": {
    "app": "mern-todo",
    "version": "1.0.0",
    "maintainer": "NebulaBox Testing"
  },
  "metadata": {
    "description": "MERN Todo App - MongoDB, Express, React, Node.js",
    "stack": ["mongodb", "express", "react", "nodejs", "nginx"]
  }
}

